# Copy to .env and fill in. `install.sh` never overwrites an existing .env.

# n8n instance key: encrypts stored credentials. Keep it, never commit it.
N8N_ENCRYPTION_KEY=CHANGE_ME

# Where n8n listens. Keep 127.0.0.1 unless you need LAN access.
N8N_BIND_IP=127.0.0.1
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678

# GitHub API token. Fine-grained token: Contents=Read, Pull requests=Read,
# Metadata=Read on the tracked repositories. Classic token: `repo`
# (or `public_repo` if every tracked repo is public).
GITHUB_TOKEN=PASTE_GITHUB_TOKEN

# Repos to track, comma separated owner/name.
TRACKED_REPOS=emiliano-go/trustsight,emiliano-go/trustsight-feed,emiliano-go/trustsight-harness,emiliano-go/trustsight-web,emiliano-go/trustsight-triage-agent,emiliano-go/trustsight-lab,emiliano-go/rypipe,dbwarden-org/dbwarden

# How often to hit GitHub, in minutes (minimum 5).
GITHUB_POLL_MINUTES=15

# How often merged PRs are folded into one "features shipped" digest, in hours.
DIGEST_HOURS=6
# Wait this long after the last merge before posting, so a burst lands in one post.
DIGEST_QUIET_MINUTES=60
# Approved posts go out one at a time, this many minutes apart.
POST_INTERVAL_MINUTES=15
# Each gap varies by up to this many minutes, to the second.
POST_JITTER_MINUTES=2

# Shared secret for the DSH approval endpoint (/webhook/totem-approvals).
DSH_WEBHOOK_TOKEN=CHANGE_ME_LONG_RANDOM

# X posting stays off until you create the OAuth1 credential in n8n and flip this.
X_ENABLED=false

# OAuth 1.0a user context. Consumer pair from the app's Keys page, access pair
# from "Access Token and Secret" (the app must be Read and write when generated).
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional. Without a key the workflow falls back to a plain template draft.
# Defaults to Google's free Gemini tier (OpenAI-compatible, no card).
# Key: https://aistudio.google.com/apikey
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.5-flash

# Any OpenAI-compatible endpoint works instead:
#   3.8/3.7 Flash are newer but frequently return 503 at peak; 3.5 Flash is the
#   reliable pick on the free tier. 2.5 Flash is 404 for newer AI Studio projects.
#   NVIDIA NIM:       OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
#                     OPENAI_MODEL=meta/llama-3.3-70b-instruct
#                     (hosted catalog is dev/eval only, limits unpublished)
#   Local Ollama:     OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#                     OPENAI_MODEL=qwen2.5:7b
